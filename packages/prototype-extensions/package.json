{
    "name": "@almighty-shogun/prototype-extensions",
    "description": "Side-effect prototype extensions for Array, String, and Number helpers.",
    "version": "0.0.0",
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "author": {
        "name": "Almighty-Shogun",
        "email": "alm1ghtyshogun1998@gmail.com",
        "url": "https://shogun.ms"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Almighty-Shogun/node-packages.git",
        "directory": "packages/prototype-extensions"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "typings": "./dist/index.d.ts",
    "sideEffects": true,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "src",
        "dist",
        "LICENSE",
        "CODEOWNERS"
    ],
    "devDependencies": {
        "typescript": "^5.9.3"
    }
